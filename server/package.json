{
  "name": "dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Parental-controls dashboard: Fastify orchestrator for Timekpr-nExT, ActivityWatch, e2guardian, and AdGuard Home.",
  "license": "SEE LICENSE IN ../LICENSE",
  "author": "Ben Seymour",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.4.1",
    "croner": "^9.1.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.1",
    "ssh2": "^1.17.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.8",
    "@types/ssh2": "^1.15.5",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenSeymourODB/linux-parental-controls-toolkit.git"
  }
}
