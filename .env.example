# Dashboard configuration — copy to .env and adjust.
# Parsed and validated by server/src/config.ts (loadSettings). All values
# below are the defaults; uncomment and change only what you need.

# Path to the SQLite policy store (better-sqlite3 / Drizzle). A bare path
# and the libsql `file:` URL form (e.g. file:/data/policy.sqlite, used by CI
# and drizzle.config.ts) are equivalent: the loader strips a leading `file:`
# so drizzle-kit and the runtime always open the same file.
# DATABASE_URL=/data/policy.sqlite

# Automatic pre-migration snapshot (#166). Before the server applies schema
# migrations in-process on boot, an existing policy.sqlite with pending
# migrations is snapshotted (SQLite VACUUM INTO) so a regretted upgrade is
# recoverable — the automatic counterpart to scripts/pct-data-backup.sh. A fresh
# DB is skipped. Disable only if you snapshot /data externally.
# PCT_PRE_MIGRATION_BACKUP=true
# Where snapshots are written; defaults to <dirname(DATABASE_URL)>/backups.
# PCT_PRE_MIGRATION_BACKUP_DIR=/data/backups
# How many snapshots to keep (older ones are pruned). Positive integer.
# PCT_PRE_MIGRATION_BACKUP_RETAIN=5

# Filesystem root of the prerendered SvelteKit build served at /admin and
# /app. Defaults to the in-image path the Dockerfile copies the build into;
# override only for local dev (e.g. point at server/frontend/build). If the
# path is absent the mount is skipped and those surfaces 404.
# PCT_FRONTEND_ROOT=/app/frontend

# Server-default IANA timezone for budget rollover. A user's effective
# timezone is User.tz ?? PCT_DEFAULT_TZ; it decides when daily/weekly/monthly
# budgets roll over (see docs/adr/0001-budget-timezone.md). Must be a valid
# IANA name (validated at startup). Defaults to UTC.
# PCT_DEFAULT_TZ=UTC

# pino log level: trace | debug | info | warn | error | fatal | silent
# PCT_LOG_LEVEL=info

# Trust X-Forwarded-* from a reverse proxy so request.ip is the real client IP
# (Fastify's trustProxy). Default OFF — never trust forwarded headers from an
# untrusted direct caller on a LAN. Turn on ONLY behind a trusted proxy so the
# per-IP failed-attempt limiter (admin login, POST /api/clients/enrol) keys on
# the real client IP. Accepts: a boolean (true/false/yes/no/on/off), a hop
# count (e.g. 1), or a comma-separated IP/CIDR allowlist (e.g.
# 127.0.0.1,10.0.0.0/8). See docs/reverse-proxy-tls.md → "Client IP and the
# failed-attempt limiter".
# PCT_TRUST_PROXY=false

# Signs the admin session cookie (and, later, integration tokens). Set a long
# random value in any real deployment — until it is set, login and the admin
# guard fail closed with 503 (a session cannot be signed without it).
# PCT_SECRET_KEY=

# First-admin bootstrap (single-admin auth). On first run, if no admin exists
# and BOTH of these are set, the admin login is seeded from them: the password
# is Argon2id-hashed immediately and the plaintext is never stored. Seeding is
# idempotent (a restart never reseeds), so you can drop PCT_ADMIN_PASSWORD from
# the environment after the first successful start. See docs/server-deployment.md
# → "Authentication".
# PCT_ADMIN_USERNAME=admin
# PCT_ADMIN_PASSWORD=change-me-on-first-run

# Root of the data-volume Ansible directory (Phase 6). The runner resolves
# ansible-playbook at <dir>/venv/bin/ and playbooks under <dir>/playbooks/;
# the venv is bootstrapped here on first run. Defaults to the documented
# /data/ansible layout — see docs/server-deployment.md → "Volume layout".
# PCT_ANSIBLE_DIR=/data/ansible

# Path to the dashboard's SSH PUBLIC key, returned in the client-enrolment
# response (POST /api/clients/enrol) so the client can authorize the dashboard
# in pct-agent's authorized_keys. The key pair is generated server-side as a
# Phase-4 first-run step; until then the file is absent and the response carries
# sshPublicKey: null. Defaults to the documented /data/secrets/ssh layout.
# PCT_SSH_PUBLIC_KEY_PATH=/data/secrets/ssh/id_ed25519.pub

# Data retention: the global default window (days) applied to every dated-data
# category that has no per-category override. Per-category overrides (a custom
# window or "keep forever") are set at runtime via PUT /api/retention/:category
# and stored in the policy DB — only this default lives in the environment.
# Must be a positive integer; "effectively forever" is the per-category
# keep-forever mode, not a giant number here. Defaults to 365 (one year).
# See docs/server-deployment.md → "Data retention".
# PCT_RETENTION_DEFAULT_DAYS=365

# --- AdGuard Home (optional DNS filtering) ----------------------------------
# Mode: disabled (default) | external | managed
# See docs/server-deployment.md → "AdGuard Home deployment modes".
# PCT_ADGUARD_MODE=disabled

# external — point at an AdGuard Home instance you already run:
# PCT_ADGUARD_MODE=external
# PCT_ADGUARD_URL=https://adguard.lan
# PCT_ADGUARD_USERNAME=parental-controls
# PCT_ADGUARD_PASSWORD_FILE=/run/secrets/adguard_password
# or, instead of a password:
# PCT_ADGUARD_API_TOKEN_FILE=/run/secrets/adguard_token

# managed — the dashboard fetches and supervises AdGuard Home itself:
# PCT_ADGUARD_MODE=managed
# PCT_ADGUARD_BIND_ADDR=0.0.0.0:53
# PCT_ADGUARD_ADMIN_PORT=3000
# PCT_ADGUARD_DATA_DIR=/data/adguard   # binary + config + work dir live here
# PCT_ADGUARD_VERSION=v0.107.65        # optional: pin a release; latest if unset
