{#
  e2guardian filter-group config for a single supervised user. groupmode = 1
  (filtered) with a per-user banned-site list; the permissive baseline stays on
  group 1 (client/install-baseline-tools.sh). The dashboard assigns the group
  number + listen port deterministically. Recurring time-window denies (#216)
  are pulled in as extra `.Include`s carrying a `#time:` tag, so e2guardian only
  applies them during the window. Managed by #90/#216 — do not hand-edit.
-#}
# Managed by pct e2guardian-filtering.yml (#90).
# Filter group {{ item.filterGroup }} for supervised user '{{ item.osUsername }}'
# (ref={{ item.osUserRef }}); traffic arrives on listen port {{ item.listenPort }}.
groupname = 'pct-{{ item.osUsername }}'
groupmode = 1
naughtynesslimit = 9999
reportinglevel = 0
.Include<{{ "/etc/e2guardian/pct.d/" ~ item.osUsername ~ ".bannedsites" }}>
{% for window in item.windows | default([]) %}
.Include<{{ "/etc/e2guardian/pct.d/" ~ item.osUsername ~ "-win-" ~ (window.timeTag | replace(" ", "-")) ~ ".bannedsites" }}>#time: {{ window.timeTag }}
{% endfor %}
